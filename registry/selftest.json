      "urlByPlatform": {
        "chatgpt": {
          "type": "template",
          "template": "{{base}}&cc=selftest",
          "variables": {
            "base": {
              "type": "fileRegex",
              "path": "D:/GDrive/HELM/DEV-PROJECTS/Connectors/HELM Drive MCP Connector/Repos/TT-MCP/connector-info.txt",
              "pattern": "https://mcp\\.trentt\\.me/mcp\\?token=[^\\s\"'<>]+"
            }
          }
        },
        "grok": {
          "type": "template",
          "template": "{{base}}&cc=selftest",
          "variables": {
            "base": {
              "type": "fileRegex",
              "path": "D:/GDrive/HELM/DEV-PROJECTS/Connectors/HELM Drive MCP Connector/Repos/TT-MCP/connector-info.txt",
              "pattern": "https://mcp\\.trentt\\.me/mcp\\?token=[^\\s\"'<>]+"
            }
          }
        }
      },
      "auth": {
        "mode": "header",
        "headerName": "x-api-key",
        "headerValue": {
          "type": "envFile",
