    {
      "id": "helm-drive",
      "name": "HELM Drive MCP Connector",
      "repo": "trentet/helm-drive-mcp",
      "description": "Private HELM Drive MCP endpoint",
      "url": {
        "type": "fileRegex",
        "path": "D:/GDrive/HELM/DEV-PROJECTS/Connectors/HELM Drive MCP Connector/Repos/helm-drive-mcp/connector-info.txt",
        "pattern": "https://mcp\\.trentt\\.me/mcp\\?token=[^\\s\"'<>]+"
      },
      "auth": {
        "mode": "none"
      },
      "platforms": [
        "claude",
        "chatgpt",
        "grok"
      ],
      "nameByPlatform": {
        "claude": "HELM Drive Connector",
        "grok": "HELMMCP"
      },
      "googleOAuth": {
        "secretsDir": "%LOCALAPPDATA%\\HELM\\helm-drive-mcp\\production\\secrets",
        "scopes": [
          "https://www.googleapis.com/auth/drive",
          "https://www.googleapis.com/auth/documents",
          "https://www.googleapis.com/auth/spreadsheets",
          "https://www.googleapis.com/auth/gmail.readonly"
        ],
        "account": {
          "vaultLabel": "Google Account (trenterrolthomas@gmail.com)"
        },
        "restart": {
          "command": "node %LOCALAPPDATA%\\HELM\\helm-drive-mcp\\deploy\\production\\scripts\\restart.mjs production"
        },
        "health": {
          "url": "http://127.0.0.1:8787/health",
          "contains": "\"status\":\"ok\"",
          "waitSeconds": 60
        }
      }
    },
